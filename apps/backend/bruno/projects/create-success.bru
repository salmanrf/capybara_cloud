meta {
  name: create project - success (saves project_id)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/projects
  body: json
  auth: none
}

body:json {
  {
    "org_id": "{{org_id}}",
    "name": "my-test-project"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.project_id) {
    bru.setEnvVar("project_id", res.body.data.project_id);
  }
}
