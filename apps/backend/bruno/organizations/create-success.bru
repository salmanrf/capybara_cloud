meta {
  name: create org - success (saves org_id)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/organizations
  body: json
  auth: none
}

body:json {
  {
    "name": "my-test-org"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.org_id) {
    bru.setEnvVar("org_id", res.body.data.org_id);
  }
}
