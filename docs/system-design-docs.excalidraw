        "P93HZXKP7N8Mbc9e2MERo"
      ],
      "frameId": null,
      "index": "b0y",
      "roundness": null,
      "seed": 76013280,
      "version": 2218,
      "versionNonce": 2040694039,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776732733570,
      "link": null,
      "locked": false,
      "text": "- Consume \"deployment_created\" message\n- Publish \"deployment_terminated\" message\n- Publish \"deployment_succeeded\" message",
