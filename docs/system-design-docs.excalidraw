    {
      "id": "UEcirEmdcWxRf6qTx-LmA",
      "type": "text",
      "x": 86.76020906791024,
      "y": 2681.4359038133352,
      "width": 322.0013122558594,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
