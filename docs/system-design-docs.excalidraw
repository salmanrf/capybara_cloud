    {
      "id": "V_K9m6GdCIEYlTvFUx3KL",
      "type": "text",
      "x": -2951.104027632319,
      "y": 4978.427067036881,
      "width": 902.9190673828125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5opV",
      "roundness": null,
      "seed": 1880313751,
      "version": 1770,
      "versionNonce": 1179091663,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776810892391,
      "link": null,
      "locked": false,
      "text": "Authorization consists of two steps, validating credentials and validating permissions,\nValidating credentials could and should be delegated to the same Auth server, while\nvalidating permissions are typically module specific, and each module should only be concerned\nwith validating permission to APIs they serve. \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authorization consists of two steps, validating credentials and validating permissions,\nValidating credentials could and should be delegated to the same Auth server, while\nvalidating permissions are typically module specific, and each module should only be concerned\nwith validating permission to APIs they serve. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
