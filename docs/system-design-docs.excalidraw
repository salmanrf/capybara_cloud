      "type": "text",
      "x": -2957.088466976639,
      "y": 5216.644865742981,
      "width": 902.9190673828125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4KO",
      "roundness": null,
      "seed": 1880313751,
      "version": 1433,
      "versionNonce": 1046504697,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776732705796,
      "link": null,
      "locked": false,
      "text": "Authorization consists of two steps, validating credentials and validating permissions,\nValidating credentials could and should be delegated to the same Auth server, while\nvalidating permissions are typically module specific, and each module should only be concerned\nwith validating permission to APIs they serve. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authorization consists of two steps, validating credentials and validating permissions,\nValidating credentials could and should be delegated to the same Auth server, while\nvalidating permissions are typically module specific, and each module should only be concerned\nwith validating permission to APIs they serve. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
