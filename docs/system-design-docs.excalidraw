      "groupIds": [
        "P93HZXKP7N8Mbc9e2MERo"
      ],
      "frameId": null,
      "index": "b5nJ",
      "roundness": null,
      "seed": 76013280,
      "version": 2369,
      "versionNonce": 1814609281,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776858088450,
      "link": null,
      "locked": false,
      "text": "- Consume \"deployment_created\" message\n- Publish \"deployment_terminated\" message\n- Publish \"deployment_succeeded\" message",
