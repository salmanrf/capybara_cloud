    },
    {
      "id": "ktXNQrMLuVdkdC5q2wtAc",
      "type": "text",
      "x": 88.41465583103616,
      "y": 3144.3774874652727,
      "width": 993.3189697265625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#12b886",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aKV",
      "roundness": null,
      "seed": 436314912,
      "version": 1215,
      "versionNonce": 1627909367,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776726587088,
      "link": null,
      "locked": false,
      "text": "Capybara cloud exposes two main types of interface, HTTP REST API server for space\nand deployment management, and an MCP interfaces for AI models to communicate with.  \n\n\nThe nature of a our service (Platform) requires that applications can be deployed to multiple servers,\nideally at multiple different locations for reliability and scalability.\n\nMicroservices Architecture is therefor the most logical choice.  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Capybara cloud exposes two main types of interface, HTTP REST API server for space\nand deployment management, and an MCP interfaces for AI models to communicate with.  \n\n\nThe nature of a our service (Platform) requires that applications can be deployed to multiple servers,\nideally at multiple different locations for reliability and scalability.\n\nMicroservices Architecture is therefor the most logical choice.  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
