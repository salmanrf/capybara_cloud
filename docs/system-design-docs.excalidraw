    {
      "id": "8Lfz9xwSxhAZZBMcxzqm5",
      "type": "text",
      "x": -750.1322678177503,
      "y": 8712.291652347008,
      "width": 416.5196228027344,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
