    {
      "id": "NZepb1x9R8Wl7Qw1tT2tf",
      "type": "text",
      "x": -2959.038093201318,
      "y": 4589.359373169863,
      "width": 1026.59912109375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
