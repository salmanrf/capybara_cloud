    {
      "id": "8Lfz9xwSxhAZZBMcxzqm5",
      "type": "text",
      "x": -905.5607346146253,
      "y": 10934.713527347008,
      "width": 416.5196228027344,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "P93HZXKP7N8Mbc9e2MERo"
      ],
      "frameId": null,
      "index": "b5nJ",
      "roundness": null,
      "seed": 76013280,
      "version": 2479,
      "versionNonce": 1467727322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779017187353,
      "link": null,
      "locked": false,
      "text": "- Consume \"deployment_created\" message\n- Publish \"deployment_terminated\" message\n- Publish \"deployment_succeeded\" message",
