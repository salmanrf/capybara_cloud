    {
      "id": "Xg2TaSoe73OFBSGTHei7E",
      "type": "text",
      "x": 3682.7696490475273,
      "y": 11147.272799231814,
      "width": 867.9191284179688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "NINyTCLkSdPbW5tGKQD5j"
      ],
      "frameId": null,
      "index": "b88",
      "roundness": null,
      "seed": 754777459,
      "version": 1842,
      "versionNonce": 2067964506,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779017187354,
      "link": null,
      "locked": false,
      "text": "- PUT /app-hosts -> Create/Update a new application to be served from the web server\n\n- GET /app-hosts -> List all application hosts registered \n\n- DELETE /app-hosts -> DELETE an application host (stop serving)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- PUT /app-hosts -> Create/Update a new application to be served from the web server\n\n- GET /app-hosts -> List all application hosts registered \n\n- DELETE /app-hosts -> DELETE an application host (stop serving)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZKeWfKVo4G8ULKZFcELMN",
      "type": "text",
      "x": 3678.7976288359123,
      "y": 11409.692558885716,
      "width": 480.64996337890625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "T4g6o_LOOMo6aRwzaVBP8"
      ],
      "frameId": null,
      "index": "b8C",
