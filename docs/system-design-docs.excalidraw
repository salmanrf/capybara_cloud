      "versionNonce": 793856513,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776810346011,
      "link": null,
      "locked": false,
      "text": "Mechanism - Exposing Application Interface:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mechanism - Exposing Application Interface:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rnNLi_juRu609buHwtgZV",
      "type": "text",
      "x": 2793.764040151508,
      "y": 5277.114424993585,
      "width": 1085.759033203125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "l_cFIxV9L2UAzbUuAlwrG"
      ],
      "frameId": null,
      "index": "b5oy",
      "roundness": null,
      "seed": 1670675991,
      "version": 5405,
      "versionNonce": 360341985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776810346011,
      "link": null,
      "locked": false,
      "text": "Upon successful deployment, the host need to expose the port to the app, \nand telling other modules to direct application traffic to them.\n\nWe do this by adding a Web Server + Reverse Proxy layer between the hosts and the Deployment module.\nThe host publishes a \"deployment_succceded\" message to the deployment channel\", the deployment module then\nconsumes this message and update the configuration of the Reverse proxy. \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upon successful deployment, the host need to expose the port to the app, \nand telling other modules to direct application traffic to them.\n\nWe do this by adding a Web Server + Reverse Proxy layer between the hosts and the Deployment module.\nThe host publishes a \"deployment_succceded\" message to the deployment channel\", the deployment module then\nconsumes this message and update the configuration of the Reverse proxy. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
