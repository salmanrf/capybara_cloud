    {
      "id": "k-_bVGxAvE0R6qiE0NKb0",
      "type": "text",
      "x": 297.00206519739504,
      "y": 219.13679109805074,
      "width": 164.22067260742188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
