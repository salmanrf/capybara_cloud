    },
    {
      "id": "_ObcpciQoAcfN94Tc5jFU",
      "type": "text",
      "x": 1345.8810535219295,
      "y": 7899.684452036781,
      "width": 439.15380859375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "eIfytY_jARQ-HNbXhIQJR"
      ],
      "frameId": null,
      "index": "b10l",
