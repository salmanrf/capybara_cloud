    {
      "id": "5iNaDyYCxhRAOE2Fl_B9B",
      "type": "text",
      "x": 2793.208684292414,
      "y": 5225.692785885028,
      "width": 600.12646484375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
