      "text": "Mechanism - Maintaining Hosts:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mechanism - Maintaining Hosts:",
      "autoResize": true,
