    {
      "id": "8Lfz9xwSxhAZZBMcxzqm5",
      "type": "text",
      "x": -819.3119553177503,
      "y": 7788.345271731774,
      "width": 416.5196228027344,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
