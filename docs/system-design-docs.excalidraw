    {
      "id": "KOFq2LyAwQuJef7kaFOJm",
      "type": "text",
      "x": 300.48644019739504,
      "y": 56.80866609805079,
      "width": 758.7192993164062,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#4dabf7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1174322592,
      "version": 642,
      "versionNonce": 95957408,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776520717655,
      "link": null,
      "locked": false,
      "text": "In Capybara cloud, you are not limited to choose AWS, GCP, or Alibaba Cloud\nas the underlying infrastructure, you CAN still use those cloud providers here,\nOR you can spawn your own machine, connect it to the internet and let it \njoin the \"provisioning\" group.   ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Capybara cloud, you are not limited to choose AWS, GCP, or Alibaba Cloud\nas the underlying infrastructure, you CAN still use those cloud providers here,\nOR you can spawn your own machine, connect it to the internet and let it \njoin the \"provisioning\" group.   ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8CQhmzoVahT-CuOJZsnXF",
      "type": "text",
      "x": 296.32628394739504,
      "y": 275.6056631683632,
      "width": 860.2792358398438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#4dabf7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4V",
      "roundness": null,
      "seed": 1953369504,
      "version": 1005,
      "versionNonce": 788594080,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776520717655,
      "link": null,
      "locked": false,
      "text": "Capybara cloud is designed and built with ease of use in mind, therefore,\nsetting up your cloud environment can be as simple as talking with Claude, or ChatGPT. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Capybara cloud is designed and built with ease of use in mind, therefore,\nsetting up your cloud environment can be as simple as talking with Claude, or ChatGPT. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
