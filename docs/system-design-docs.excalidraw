      "seed": 428012825,
      "version": 559,
      "versionNonce": 2032697391,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "mthwqWIsIIZJKaiExezna",
          "type": "arrow"
        }
      ],
      "updated": 1776810867101,
      "link": null,
      "locked": false,
      "text": "Since our architecture consists of microservices communicating with each other, we need a standard way \nof granting credentials (Authentication), and verifying them (Authorization), \nOAuth2 is a natural choice as it's widely adopted, and can delegate these operations to a trusted \n3rd party Auth server (e.g Auth0, Clerk).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Since our architecture consists of microservices communicating with each other, we need a standard way \nof granting credentials (Authentication), and verifying them (Authorization), \nOAuth2 is a natural choice as it's widely adopted, and can delegate these operations to a trusted \n3rd party Auth server (e.g Auth0, Clerk).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UgVl_AXbKiN5En0yUEGpx",
      "type": "text",
      "x": -2961.1327403613136,
      "y": 4796.719383390028,
      "width": 1063.098876953125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5pA",
      "roundness": null,
      "seed": 443422039,
      "version": 632,
      "versionNonce": 1069819809,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776810129015,
      "link": null,
      "locked": false,
      "text": "Authentication operations are standardized between modules, and between users and our Back-end platform.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authentication operations are standardized between modules, and between users and our Back-end platform.",
      "autoResize": true,
      "lineHeight": 1.25
    },
