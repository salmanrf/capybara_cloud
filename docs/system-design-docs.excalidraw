      "isDeleted": false,
      "boundElements": [],
      "updated": 1776772570230,
      "link": null,
      "locked": false,
      "text": "Each module takes care of obtaining their access token and caching them, whether in memory, \nor in external storage. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each module takes care of obtaining their access token and caching them, whether in memory, \nor in external storage. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
