    },
    {
      "id": "2XtLjeTQMWDgsPFed-s5D",
      "type": "text",
      "x": 1076.4758924914117,
      "y": 5871.439144400276,
      "width": 928.0592041015625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 482422496,
      "version": 974,
      "versionNonce": 2117680921,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776726500242,
      "link": null,
      "locked": false,
      "text": "The deployment module leverages techniques of Event Sourcing and CQRS, \nFor example, On a new deployment, an event of type \"deployment_created\" is first appended to\nlogs, and then, a row to the \"deployments\" table that serves as the materialized view.\nIf this sequence of operation was successful, the deployment module simply publish a message\nto tell the \"hosts\" (i.e servers made available to run the apps), that one of them should pull\nthe metadata of the application and start it.      ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The deployment module leverages techniques of Event Sourcing and CQRS, \nFor example, On a new deployment, an event of type \"deployment_created\" is first appended to\nlogs, and then, a row to the \"deployments\" table that serves as the materialized view.\nIf this sequence of operation was successful, the deployment module simply publish a message\nto tell the \"hosts\" (i.e servers made available to run the apps), that one of them should pull\nthe metadata of the application and start it.      ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hm_M75JRhhELMNNMGMQIm",
      "type": "text",
      "x": 1071.8196424914117,
      "y": 6176.638363150276,
      "width": 895.0792846679688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#6741d9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 384800480,
      "version": 1254,
      "versionNonce": 315880441,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776726500242,
      "link": null,
      "locked": false,
      "text": "The module subscribes to the \"deployment\" message channel and track changes from therein\nby appending new logs for each events. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The module subscribes to the \"deployment\" message channel and track changes from therein\nby appending new logs for each events. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
