      "link": null,
      "locked": false,
      "text": "Mechanism - Registering an application",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mechanism - Registering an application",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "N4SNczKdX-SaToqs_6AMN",
      "type": "text",
      "x": 5253.247428332044,
      "y": 11422.991130037788,
      "width": 526.2621459960938,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "bcNYknaI7OMideEOsSzcX"
      ],
      "frameId": null,
      "index": "b8FG",
      "roundness": null,
      "seed": 1498414931,
      "version": 844,
      "versionNonce": 1320789338,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779017187354,
      "link": null,
      "locked": false,
      "text": "Mechanism - Maintining Web Interfaces",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mechanism - Maintining Web Interfaces",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Qto_9etYeKHrXI7Uzgw0l",
      "type": "text",
      "x": 3675.1312028863244,
      "y": 11861.522051819815,
      "width": 1171.298828125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8G",
      "roundness": null,
      "seed": 1148624307,
      "version": 764,
      "versionNonce": 1171253786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779017187354,
      "link": null,
      "locked": false,
      "text": "Upon successful deployment, the deployment module receives \"deployment_succeeded\" event, which triggers it to\ninsert a new event log to it's database and updates the deployment entry.\n\nOnce all of these had been done, the deployment module can call the Web module's PUT /app-hosts endpoint, \nwhich updates the config of the web server with a new reverse proxy host that points to the provisioning host running\nthe app.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upon successful deployment, the deployment module receives \"deployment_succeeded\" event, which triggers it to\ninsert a new event log to it's database and updates the deployment entry.\n\nOnce all of these had been done, the deployment module can call the Web module's PUT /app-hosts endpoint, \nwhich updates the config of the web server with a new reverse proxy host that points to the provisioning host running\nthe app.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bwacSI2XPMf-A11toA7CD",
      "type": "text",
      "x": 5255.970188870251,
      "y": 11489.970466456985,
      "width": 1372.7786865234375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
