      "seed": 1627257248,
      "version": 339,
      "versionNonce": 273016224,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776520717655,
      "link": null,
      "locked": false,
      "text": "AI Assisted",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AI Assisted",
      "autoResize": true,
