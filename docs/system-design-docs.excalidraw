      "isDeleted": false,
      "boundElements": [],
      "updated": 1779017187354,
      "link": null,
      "locked": false,
      "text": "Mechanism - Maintaining Web Server",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mechanism - Maintaining Web Server",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1mrfcg1Y0HclO4a4nfZbg",
      "type": "text",
      "x": 3678.5700765664733,
      "y": 11463.521190574627,
      "width": 1185.73876953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "T4g6o_LOOMo6aRwzaVBP8"
      ],
      "frameId": null,
      "index": "b8D",
      "roundness": null,
      "seed": 1684143891,
      "version": 1294,
      "versionNonce": 1164792794,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779017187354,
      "link": null,
      "locked": false,
      "text": "To increase the security of the provisioning hosts, we want to expose as little interfaces (e.g service ports) as possible\nto them, to do so the hosts explicitly expose only the ports actively used by applications they are hosting.\n\nUsers' requests then need not go directly to these hosts, but instead go through this Web Module, which maintains a\n3rd party web server, Caddy, which in turn redirects the requests to the actual applications.\n\nThe Web module is therefor responsible for starting, updating, and maintaining the lifecycle of this 3rd party web server.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To increase the security of the provisioning hosts, we want to expose as little interfaces (e.g service ports) as possible\nto them, to do so the hosts explicitly expose only the ports actively used by applications they are hosting.\n\nUsers' requests then need not go directly to these hosts, but instead go through this Web Module, which maintains a\n3rd party web server, Caddy, which in turn redirects the requests to the actual applications.\n\nThe Web module is therefor responsible for starting, updating, and maintaining the lifecycle of this 3rd party web server.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v6RnnfWcElD9nGq4RXkJX",
      "type": "text",
      "x": 3672.408442348118,
      "y": 11794.542715400617,
      "width": 521.4461059570312,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "xXtKVPhGM48uNmN4sMXOO"
      ],
      "frameId": null,
      "index": "b8E",
      "roundness": null,
      "seed": 1727128125,
      "version": 665,
      "versionNonce": 923388058,
      "isDeleted": false,
      "boundElements": [],
