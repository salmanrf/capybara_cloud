    {
      "id": "A-7Mjq2Gpelmv8JK5NMYa",
      "type": "text",
      "x": -3871.2505709618863,
      "y": 15196.125447480474,
      "width": 161.33985900878906,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
